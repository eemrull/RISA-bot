<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RisaBotApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:RisaBotApp.Pages"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <!-- 
        Flat route structure — all navigation done programmatically via Shell.GoToAsync.
        NavBar and TabBar are hidden globally; the DashboardPage manages its own tab UI.
    -->

    <ShellContent
        Route="SplashPage"
        ContentTemplate="{DataTemplate pages:SplashPage}"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Route="DiscoveryPage"
        ContentTemplate="{DataTemplate pages:DiscoveryPage}"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Route="WifiSetupPage"
        ContentTemplate="{DataTemplate pages:WifiSetupPage}"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Route="DashboardPage"
        ContentTemplate="{DataTemplate pages:DashboardPage}"
        Shell.NavBarIsVisible="False" />

</Shell>
