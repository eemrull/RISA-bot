<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RisaBotApp.Pages.WifiSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RisaBotApp.ViewModels"
    x:DataType="vm:WifiSetupViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <VerticalStackLayout Grid.Row="0" Padding="24,56,24,16" Spacing="4">
            <Label Text="WiFi Setup" FontFamily="InterBold" FontSize="28" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Connect robot to your network" FontFamily="InterRegular" FontSize="14" TextColor="{StaticResource TextMuted}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0" Spacing="20">

                <!-- ── Connection progress (shown while connecting) ──────── -->
                <Border
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="20"
                    IsVisible="{Binding IsConnecting}">
                    <VerticalStackLayout Spacing="0">
                        <Label
                            Text="Connecting…"
                            FontFamily="InterSemiBold"
                            FontSize="16"
                            TextColor="{StaticResource TextPrimary}"
                            Margin="0,0,0,16" />
                        <CollectionView ItemsSource="{Binding Steps}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionStep">
                                    <Grid ColumnDefinitions="32, *" ColumnSpacing="12" Padding="0,10">
                                        <!-- Step status indicator -->
                                        <ActivityIndicator
                                            Grid.Column="0"
                                            IsRunning="True"
                                            Color="{StaticResource AccentBlue}"
                                            WidthRequest="20"
                                            HeightRequest="20"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsActive}" />
                                        <Label
                                            Grid.Column="0"
                                            Text="✓"
                                            FontSize="18"
                                            TextColor="{StaticResource AccentGreen}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsDone}" />
                                        <Label
                                            Grid.Column="0"
                                            Text="✗"
                                            FontSize="18"
                                            TextColor="{StaticResource ErrorText}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsFailed}" />
                                        <Label
                                            Grid.Column="0"
                                            Text="○"
                                            FontSize="18"
                                            TextColor="{StaticResource TextMuted}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsPending}" />
                                        <!-- Step label -->
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Label}"
                                            FontFamily="InterRegular"
                                            FontSize="14"
                                            TextColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#E8F0FF,#888899'}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Error state ───────────────────────────────────────── -->
                <Border
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource ErrorBackground}"
                    Padding="20"
                    IsVisible="{Binding HasError}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Connection Failed" FontFamily="InterSemiBold" FontSize="16" TextColor="{StaticResource ErrorText}" />
                        <Label Text="{Binding ErrorMessage}" FontFamily="InterRegular" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap" />
                        <Button
                            Text="Try Again"
                            Command="{Binding RetryConnectionCommand}"
                            BackgroundColor="{StaticResource ErrorText}"
                            TextColor="White"
                            FontFamily="InterSemiBold"
                            CornerRadius="10"
                            HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Network list (shown when not connecting) ──────────── -->
                <VerticalStackLayout
                    Spacing="12"
                    IsVisible="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}">

                    <Label
                        Text="Available Networks"
                        FontFamily="InterSemiBold"
                        FontSize="14"
                        TextColor="{StaticResource TextMuted}" />

                    <!-- Scan loading indicator -->
                    <ActivityIndicator
                        IsRunning="{Binding IsScanning}"
                        IsVisible="{Binding IsScanning}"
                        Color="{StaticResource AccentBlue}"
                        HorizontalOptions="Center"
                        HeightRequest="36" />

                    <CollectionView
                        ItemsSource="{Binding Networks}"
                        SelectionMode="None"
                        IsVisible="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WifiNetworkItem">
                                <Border
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="16,14"
                                    Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                        <!-- Signal icon -->
                                        <Label Grid.Column="0" Text="{Binding SignalEmoji}" FontSize="22" VerticalOptions="Center" />
                                        <!-- SSID + security -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Network.Ssid}" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding Network.Security}" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>
                                        <!-- Connect chevron -->
                                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNetworkTapped" CommandParameter="{Binding Network}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Scan button ────────────────────────────────────────────────── -->
        <Button
            Grid.Row="2"
            Text="Scan for Networks"
            Command="{Binding ScanCommand}"
            BackgroundColor="{StaticResource AccentBlue}"
            TextColor="White"
            FontFamily="InterSemiBold"
            FontSize="15"
            CornerRadius="14"
            HeightRequest="52"
            Margin="24,12,24,40"
            IsVisible="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}" />

    </Grid>

</ContentPage>
