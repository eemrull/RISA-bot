<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RisaBotApp.Pages.WifiSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RisaBotApp.ViewModels"
    x:DataType="vm:WifiSetupViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="14" Padding="24,36,24,18" VerticalOptions="Center">
            <Border
                Grid.Column="0"
                Stroke="{StaticResource AccentCyan}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="{StaticResource SurfaceElevated}"
                WidthRequest="46"
                HeightRequest="46"
                Padding="6"
                VerticalOptions="Center">
                <Label Text="📡" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="WIFI PROVISIONING" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource TextPrimary}" CharacterSpacing="1" />
                <Label Text="Pair RISA-Bot to target wireless infrastructure" FontFamily="InterRegular" FontSize="12" TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ── Main Content ──────────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,4,24,20" Spacing="16">

                <!-- ── Connection Progress Timeline ──────────────────────── -->
                <Border
                    Stroke="{StaticResource BorderHighlight}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="20"
                    IsVisible="{Binding IsConnecting}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                Text="PROVISIONING IN PROGRESS"
                                FontFamily="InterBold"
                                FontSize="13"
                                TextColor="{StaticResource AccentCyan}"
                                CharacterSpacing="1" />
                            <ActivityIndicator
                                Grid.Column="1"
                                IsRunning="True"
                                Color="{StaticResource AccentCyan}"
                                WidthRequest="18"
                                HeightRequest="18" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Divider}" />

                        <CollectionView ItemsSource="{Binding Steps}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionStep">
                                    <Grid ColumnDefinitions="28, *" ColumnSpacing="12" Padding="0,8">
                                        <!-- Step status indicator -->
                                        <ActivityIndicator
                                            Grid.Column="0"
                                            IsRunning="True"
                                            Color="{StaticResource AccentCyan}"
                                            WidthRequest="18"
                                            HeightRequest="18"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsActive}" />
                                        <Border
                                            Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource SuccessBackground}"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsDone}">
                                            <Label
                                                Text="✓"
                                                FontSize="12"
                                                TextColor="{StaticResource SuccessText}"
                                                FontFamily="InterBold"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center" />
                                        </Border>
                                        <Border
                                            Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource ErrorBackground}"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsFailed}">
                                            <Label
                                                Text="✕"
                                                FontSize="12"
                                                TextColor="{StaticResource ErrorText}"
                                                FontFamily="InterBold"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center" />
                                        </Border>
                                        <Label
                                            Grid.Column="0"
                                            Text="○"
                                            FontSize="14"
                                            TextColor="{StaticResource TextDim}"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding IsPending}" />

                                        <!-- Step label -->
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Label}"
                                            FontFamily="InterMedium"
                                            FontSize="13"
                                            TextColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#F8FAFC,#72849E'}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Error State Banner ────────────────────────────────── -->
                <Border
                    Stroke="{StaticResource ErrorBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource ErrorBackground}"
                    Padding="20"
                    IsVisible="{Binding HasError}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="⚠" FontSize="20" TextColor="{StaticResource ErrorText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Connection Sequence Interrupted" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource ErrorText}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding ErrorMessage}" FontFamily="InterRegular" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                        <Button
                            Text="RETRY PROVISIONING"
                            Command="{Binding RetryConnectionCommand}"
                            BackgroundColor="{StaticResource ErrorBorder}"
                            TextColor="{StaticResource White}"
                            FontFamily="InterBold"
                            FontSize="13"
                            CharacterSpacing="1"
                            CornerRadius="10"
                            HeightRequest="42" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Network List ──────────────────────────────────────── -->
                <VerticalStackLayout
                    Spacing="12"
                    IsVisible="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}">

                    <Grid ColumnDefinitions="*, Auto">
                        <Label
                            Grid.Column="0"
                            Text="AVAILABLE WIRELESS ACCESS POINTS"
                            FontFamily="InterBold"
                            FontSize="11"
                            TextColor="{StaticResource TextMuted}"
                            CharacterSpacing="1"
                            VerticalOptions="Center" />
                        <ActivityIndicator
                            Grid.Column="1"
                            IsRunning="{Binding IsScanning}"
                            IsVisible="{Binding IsScanning}"
                            Color="{StaticResource AccentCyan}"
                            WidthRequest="18"
                            HeightRequest="18" />
                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding Networks}"
                        SelectionMode="None"
                        IsVisible="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WifiNetworkItem">
                                <Border
                                    Stroke="{StaticResource CardBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource CardBackground}"
                                    Padding="16,14"
                                    Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                        <!-- Signal icon -->
                                        <Border
                                            Grid.Column="0"
                                            Stroke="{StaticResource Divider}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource CardInner}"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            VerticalOptions="Center">
                                            <Label Text="{Binding SignalEmoji}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- SSID + Security -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Network.Ssid}" FontFamily="InterBold" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding Network.Security}" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextMuted}" />
                                        </VerticalStackLayout>

                                        <!-- Connect chevron -->
                                        <Label Grid.Column="2" Text="›" FontFamily="InterBold" FontSize="22" TextColor="{StaticResource AccentCyan}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNetworkTapped" CommandParameter="{Binding Network}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Scan Trigger Button ────────────────────────────────────────── -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource SurfaceElevated}" Padding="24,14,24,28" StrokeThickness="0">
            <Button
                Text="SCAN WIRELESS SPECTRUM"
                Command="{Binding ScanCommand}"
                BackgroundColor="{StaticResource AccentCyan}"
                TextColor="{StaticResource PrimaryDarkText}"
                FontFamily="InterBold"
                FontSize="14"
                CharacterSpacing="1"
                CornerRadius="12"
                HeightRequest="48"
                IsVisible="{Binding IsConnecting, Converter={StaticResource InvertBoolConverter}}" />
        </Border>

    </Grid>

</ContentPage>
