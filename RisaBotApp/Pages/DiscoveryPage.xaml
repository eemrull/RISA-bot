<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RisaBotApp.Pages.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RisaBotApp.Models"
    xmlns:vm="clr-namespace:RisaBotApp.ViewModels"
    x:DataType="vm:DiscoveryViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── Top Header ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" Padding="24,36,24,18" VerticalOptions="Center">
            <Border
                Grid.Column="0"
                Stroke="{StaticResource RisaCrimson}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="{StaticResource SurfaceElevated}"
                WidthRequest="46"
                HeightRequest="46"
                Padding="6"
                VerticalOptions="Center">
                <Image
                    Source="risabot_logo.png"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="FLEET RADAR" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource TextPrimary}" CharacterSpacing="1" />
                <Label Text="Discover &amp; link active RISA-Bot edge nodes" FontFamily="InterRegular" FontSize="12" TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <!-- Rescan Network Button -->
            <Button
                Grid.Column="2"
                Text="⟳  RESCAN"
                Command="{Binding RescanNetworkCommand}"
                BackgroundColor="{StaticResource SurfaceElevated}"
                BorderColor="{StaticResource CardBorder}"
                BorderWidth="1"
                TextColor="{StaticResource AccentCyan}"
                FontFamily="InterBold"
                FontSize="12"
                CornerRadius="10"
                HeightRequest="38"
                Padding="14,0"
                VerticalOptions="Center" />
        </Grid>

        <!-- ── Main Content Area ─────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,4,24,20" Spacing="16">

                <!-- Scanning Radar Progress HUD -->
                <Border
                    Stroke="{StaticResource BorderHighlight}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource SurfaceElevated}"
                    Padding="16,12"
                    IsVisible="{Binding IsScanning}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <ActivityIndicator
                            Grid.Column="0"
                            IsRunning="{Binding IsScanning}"
                            Color="{StaticResource AccentCyan}"
                            WidthRequest="22"
                            HeightRequest="22"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding StatusHint}"
                            FontFamily="InterSemiBold"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Status Hint (when idle) -->
                <Border
                    Stroke="{StaticResource Divider}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource CardInner}"
                    Padding="14,10"
                    IsVisible="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="📡" FontSize="16" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding StatusHint}"
                            FontFamily="InterRegular"
                            FontSize="12"
                            TextColor="{StaticResource TextMuted}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Error Banner -->
                <Border
                    Stroke="{StaticResource ErrorBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource ErrorBackground}"
                    Padding="16,12"
                    IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="⚠" FontSize="18" TextColor="{StaticResource ErrorText}" VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding ErrorMessage}"
                            FontFamily="InterRegular"
                            FontSize="12"
                            TextColor="{StaticResource ErrorText}"
                            LineBreakMode="WordWrap"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ── Discovered Robots Grid ────────────────────────────────── -->
                <CollectionView
                    ItemsSource="{Binding DiscoveredRobots}"
                    SelectionMode="None"
                    IsVisible="{Binding HasRobots}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DiscoveredRobotDevice">
                            <Border
                                Stroke="{StaticResource CardBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource CardBackground}"
                                Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectRobotCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="6">

                                    <!-- Robot Emoji Icon Box -->
                                    <Border
                                        Grid.Column="0"
                                        Grid.RowSpan="3"
                                        Stroke="{StaticResource Divider}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{StaticResource CardInner}"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center">
                                        <Label
                                            Text="{Binding IconEmoji}"
                                            FontSize="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <!-- Robot Display Name -->
                                    <Label
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Text="{Binding DisplayName}"
                                        FontFamily="InterBold"
                                        FontSize="16"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="TailTruncation"
                                        VerticalOptions="Center" />

                                    <!-- Connect Chevron -->
                                    <Label
                                        Grid.Column="2"
                                        Grid.Row="0"
                                        Text="›"
                                        FontFamily="InterBold"
                                        FontSize="20"
                                        TextColor="{StaticResource AccentCyan}"
                                        VerticalOptions="Center" />

                                    <!-- Model Info -->
                                    <Label
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="1"
                                        Text="{Binding DisplayModel}"
                                        FontFamily="InterRegular"
                                        FontSize="12"
                                        TextColor="{StaticResource TextMuted}"
                                        LineBreakMode="TailTruncation" />

                                    <!-- Network Status Badge -->
                                    <Border
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="2"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{Binding StatusBadgeColor, Converter={StaticResource StringToColorConverter}}"
                                        Padding="8,3"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding StatusText}"
                                            FontFamily="InterBold"
                                            FontSize="10"
                                            TextColor="#060911"
                                            CharacterSpacing="0.5" />
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ── Toggle Manual Entry / Hotspot Setup Button ────────────── -->
                <Button
                    Text="{Binding ShowManualEntry, Converter={StaticResource InvertBoolConverter}, StringFormat='⚙  Direct IP / Manual Target Machine'}"
                    Command="{Binding ToggleManualEntryCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource AccentCyan}"
                    FontFamily="InterSemiBold"
                    FontSize="13"
                    HorizontalOptions="Center"
                    Margin="0,6,0,0" />

                <!-- ── Manual Host/IP Entry Card (Collapsible) ──────────────── -->
                <Border
                    Stroke="{StaticResource BorderHighlight}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource CardBackground}"
                    Padding="20"
                    IsVisible="{Binding ShowManualEntry}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                Text="DIRECT TARGET CONNECTION"
                                FontFamily="InterBold"
                                FontSize="13"
                                TextColor="{StaticResource TextPrimary}"
                                CharacterSpacing="1" />
                            <Label
                                Grid.Column="1"
                                Text="PORT 8000"
                                FontFamily="InterSemiBold"
                                FontSize="10"
                                TextColor="{StaticResource AccentCyan}" />
                        </Grid>

                        <Label
                            Text="Specify target mDNS hostname (e.g. risabot10.local) or static IP address (e.g. 192.168.1.150)."
                            FontFamily="InterRegular"
                            FontSize="12"
                            TextColor="{StaticResource TextMuted}"
                            LineBreakMode="WordWrap" />

                        <Border
                            Stroke="{StaticResource Divider}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource CardInner}"
                            Padding="12,4">
                            <Entry
                                Placeholder="e.g. risabot10.local or 192.168.1.150"
                                Text="{Binding ManualHostInput}"
                                FontFamily="InterRegular"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource TextDim}"
                                BackgroundColor="Transparent" />
                        </Border>

                        <Button
                            Text="CONNECT TO TARGET"
                            Command="{Binding ManualConnectCommand}"
                            BackgroundColor="{StaticResource AccentCyan}"
                            TextColor="{StaticResource PrimaryDarkText}"
                            FontFamily="InterBold"
                            FontSize="13"
                            CharacterSpacing="1"
                            CornerRadius="10"
                            HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource SurfaceElevated}" Padding="20,12" StrokeThickness="0">
            <Label
                Text="🔒 Zero-Configuration mDNS &amp; UDP Beacon Protocol active"
                FontFamily="InterRegular"
                FontSize="11"
                TextColor="{StaticResource TextDim}"
                HorizontalOptions="Center" />
        </Border>

    </Grid>

</ContentPage>
