<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RisaBotApp.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RisaBotApp.Models"
    xmlns:vm="clr-namespace:RisaBotApp.ViewModels"
    x:DataType="vm:DashboardViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ── Top Cockpit Command Header ───────────────────────────────────── -->
        <Grid Grid.Row="0" Padding="24,36,24,14" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" BackgroundColor="{StaticResource SurfaceElevated}">
            <!-- Robot Logo Badge -->
            <Border
                Grid.Column="0"
                Stroke="{StaticResource RisaCrimson}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="{StaticResource CardBackground}"
                WidthRequest="44"
                HeightRequest="44"
                Padding="6"
                VerticalOptions="Center">
                <Image
                    Source="risabot_logo.png"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Robot Identity & State -->
            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding RobotName}" FontFamily="InterBold" FontSize="18" TextColor="{StaticResource TextPrimary}" />
                    <!-- Dynamic State Machine Badge -->
                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource CardInner}" Stroke="{StaticResource BorderHighlight}" StrokeThickness="1" Padding="8,2" VerticalOptions="Center">
                        <Label Text="{Binding StateName}" FontFamily="InterBold" FontSize="10" TextColor="{StaticResource AccentCyan}" CharacterSpacing="0.5" />
                    </Border>
                </HorizontalStackLayout>
                <Label Text="{Binding RobotMdns}" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <!-- ROS 2 Live Status Badge -->
            <Border
                Grid.Column="2"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{Binding RosActive, Converter={StaticResource BoolToBadgeColorConverter}}"
                Padding="12,5"
                VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="●" FontSize="9" TextColor="White" VerticalOptions="Center" />
                    <Label
                        Text="{Binding RosActive, Converter={StaticResource BoolToRosStatusConverter}}"
                        FontFamily="InterBold"
                        FontSize="11"
                        TextColor="White"
                        CharacterSpacing="0.5" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ── Main Tab Content Area ─────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,14" Spacing="16">

                <!-- ═════════════════ TELEMETRY TAB ═════════════════ -->
                <VerticalStackLayout x:Name="TelemetryTab" Spacing="14">

                    <!-- Velocity & Lap Cockpit Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="FLIGHT DYNAMICS &amp; VELOCITY" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                                <Label Grid.Column="1" Text="{Binding Lap, StringFormat='LAP {0}'}" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource AccentCyan}" CharacterSpacing="1" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <!-- Speed -->
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="LINEAR VEL" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                        <Label Text="{Binding Speed, StringFormat='{0:F2}'}" FontSize="22" FontFamily="InterBold" TextColor="{StaticResource AccentEmerald}" />
                                        <Label Text="m/s" FontSize="10" TextColor="{StaticResource TextDim}" FontFamily="InterRegular" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Distance -->
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ODOM DIST" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                        <Label Text="{Binding Distance, StringFormat='{0:F2}'}" FontSize="22" FontFamily="InterBold" TextColor="{StaticResource AccentCyan}" />
                                        <Label Text="meters" FontSize="10" TextColor="{StaticResource TextDim}" FontFamily="InterRegular" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- State -->
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="MODE" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                        <Label Text="{Binding AutoMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter='AUTO,MANUAL'}" FontSize="18" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="controller" FontSize="10" TextColor="{StaticResource TextDim}" FontFamily="InterRegular" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3-Axis IMU Orientation & Ramp Attitude Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="3-AXIS GYROSCOPE &amp; ATTITUDE" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                                <Label Grid.Column="1" Text="50 Hz IMU" FontFamily="InterSemiBold" FontSize="10" TextColor="{StaticResource AccentAmber}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="PITCH (RAMP)" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                        <Label Text="{Binding ImuPitch, StringFormat='{0:F1}°'}" FontSize="18" FontFamily="InterBold" TextColor="{StaticResource AccentAmber}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ROLL (BANK)" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                        <Label Text="{Binding ImuRoll, StringFormat='{0:F1}°'}" FontSize="18" FontFamily="InterBold" TextColor="{StaticResource AccentCyan}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="YAW (HEADING)" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                        <Label Text="{Binding ImuYaw, StringFormat='{0:F1}°'}" FontSize="18" FontFamily="InterBold" TextColor="{StaticResource AccentEmerald}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Odometry Dead-Reckoning Coordinates Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="DEAD-RECKONING POSE COORDINATES" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ODOM X" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" />
                                        <Label Text="{Binding OdomX, StringFormat='{0:F3} m'}" FontSize="14" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ODOM Y" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" />
                                        <Label Text="{Binding OdomY, StringFormat='{0:F3} m'}" FontSize="14" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="ODOM YAW" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" />
                                        <Label Text="{Binding OdomYaw, StringFormat='{0:F2} rad'}" FontSize="14" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Perception Matrix & Lane Deviation Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="COMPUTER VISION &amp; PERCEPTION MATRIX" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                                <Label Grid.Column="1" Text="{Binding LaneError, StringFormat='OFFSET: {0:F3} m'}" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource AccentCyan}" />
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Divider}" />

                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                <!-- Traffic Light Badge -->
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource CardInner}" Stroke="{StaticResource Divider}" StrokeThickness="1" Padding="12,8" Margin="0,4,8,4">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="🚦 TRAFFIC LIGHT:" FontSize="11" FontFamily="InterSemiBold" TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding TrafficLight}" FontSize="11" FontFamily="InterBold" TextColor="{StaticResource AccentEmerald}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Boom Gate Badge -->
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource CardInner}" Stroke="{StaticResource Divider}" StrokeThickness="1" Padding="12,8" Margin="0,4,8,4">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="🚧 BOOM GATE:" FontSize="11" FontFamily="InterSemiBold" TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding BoomGate, Converter={StaticResource BoolToOnlineConverter}}" FontSize="11" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Tunnel Badge -->
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource CardInner}" Stroke="{StaticResource Divider}" StrokeThickness="1" Padding="12,8" Margin="0,4,8,4">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="🚇 TUNNEL FOLLOWER:" FontSize="11" FontFamily="InterSemiBold" TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding TunnelDetected, Converter={StaticResource BoolToOnlineConverter}}" FontSize="11" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Parking Sign Badge -->
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource CardInner}" Stroke="{StaticResource Divider}" StrokeThickness="1" Padding="12,8" Margin="0,4,8,4">
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="🅿 PARKING SIGN:" FontSize="11" FontFamily="InterSemiBold" TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding ParkingSignDetected, Converter={StaticResource BoolToOnlineConverter}}" FontSize="11" FontFamily="InterBold" TextColor="{StaticResource TextPrimary}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- ═════════════════ CAMERA TAB ═════════════════ -->
                <VerticalStackLayout x:Name="CameraTab" Spacing="14" IsVisible="False">

                    <!-- Camera View Switcher Buttons -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="📷 RAW"
                            Command="{Binding SelectCamViewCommand}" CommandParameter="raw"
                            BackgroundColor="{StaticResource CardBackground}" TextColor="{StaticResource TextPrimary}"
                            FontFamily="InterBold" FontSize="11" CornerRadius="10" HeightRequest="40" Padding="0" />
                        <Button Grid.Column="1" Text="🛤 LINE"
                            Command="{Binding SelectCamViewCommand}" CommandParameter="line_follower"
                            BackgroundColor="{StaticResource CardBackground}" TextColor="{StaticResource TextPrimary}"
                            FontFamily="InterBold" FontSize="11" CornerRadius="10" HeightRequest="40" Padding="0" />
                        <Button Grid.Column="2" Text="🚦 SIGN"
                            Command="{Binding SelectCamViewCommand}" CommandParameter="signage"
                            BackgroundColor="{StaticResource CardBackground}" TextColor="{StaticResource TextPrimary}"
                            FontFamily="InterBold" FontSize="11" CornerRadius="10" HeightRequest="40" Padding="0" />
                        <Button Grid.Column="3" Text="🚧 OBSTACLE"
                            Command="{Binding SelectCamViewCommand}" CommandParameter="obstacle"
                            BackgroundColor="{StaticResource CardBackground}" TextColor="{StaticResource TextPrimary}"
                            FontFamily="InterBold" FontSize="11" CornerRadius="10" HeightRequest="40" Padding="0" />
                    </Grid>

                    <!-- Live MJPEG Stream Container -->
                    <Border Stroke="{StaticResource BorderHighlight}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="4" HeightRequest="340">
                        <WebView HorizontalOptions="Fill" VerticalOptions="Fill">
                            <WebView.Source>
                                <HtmlWebViewSource Html="{Binding CameraStreamHtml}" BaseUrl="{Binding CameraStreamBaseUrl}" />
                            </WebView.Source>
                        </WebView>
                    </Border>

                    <Label
                        Text="Live zero-latency stream via go2rtc (port 1984 · WebRTC/MJPEG)"
                        FontSize="11"
                        TextColor="{StaticResource TextDim}"
                        FontFamily="InterRegular"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

                <!-- ═════════════════ CONTROLS TAB ═════════════════ -->
                <VerticalStackLayout x:Name="ControlsTab" Spacing="14" IsVisible="False">

                    <!-- Competition & Odometry Action Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="MISSION CONTROL &amp; QUICK ACTIONS" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0" Text="⟳  RESET ODOM"
                                    Command="{Binding ResetOdometryCommand}"
                                    BackgroundColor="{StaticResource AccentCyan}"
                                    TextColor="{StaticResource PrimaryDarkText}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="46" />
                                <Button Grid.Column="1" Text="🏁  RESET COMP"
                                    Command="{Binding SendCompetitionCommandCommand}" CommandParameter="RESET"
                                    BackgroundColor="{StaticResource WarningBackground}" BorderColor="{StaticResource WarningBorder}" BorderWidth="1"
                                    TextColor="{StaticResource WarningText}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="46" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0" Text="▶  START LAP 1"
                                    Command="{Binding SendCompetitionCommandCommand}" CommandParameter="LAP1"
                                    BackgroundColor="{StaticResource SuccessBackground}" BorderColor="{StaticResource SuccessBorder}" BorderWidth="1"
                                    TextColor="{StaticResource SuccessText}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="44" />
                                <Button Grid.Column="1" Text="▶  START LAP 2"
                                    Command="{Binding SendCompetitionCommandCommand}" CommandParameter="LAP2"
                                    BackgroundColor="{StaticResource SuccessBackground}" BorderColor="{StaticResource SuccessBorder}" BorderWidth="1"
                                    TextColor="{StaticResource SuccessText}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="44" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ROS 2 Systemctl Launch Control Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="SYSTEM BRINGUP SERVICE (ROS 2)" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />

                            <ActivityIndicator IsRunning="{Binding IsActionBusy}" IsVisible="{Binding IsActionBusy}" Color="{StaticResource AccentCyan}" HorizontalOptions="Center" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0" Text="▶  START BRINGUP"
                                    Command="{Binding StartLaunchCommand}"
                                    IsEnabled="{Binding LaunchActive, Converter={StaticResource InvertBoolConverter}}"
                                    BackgroundColor="{StaticResource SuccessBackground}" BorderColor="{StaticResource SuccessBorder}" BorderWidth="1"
                                    TextColor="{StaticResource SuccessText}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="46" />
                                <Button Grid.Column="1" Text="■  STOP BRINGUP"
                                    Command="{Binding StopLaunchCommand}"
                                    IsEnabled="{Binding LaunchActive}"
                                    BackgroundColor="{StaticResource ErrorBackground}" BorderColor="{StaticResource ErrorBorder}" BorderWidth="1"
                                    TextColor="{StaticResource ErrorText}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="46" />
                            </Grid>

                            <Button Text="⟳  RESTART ROS 2 NODE GRAPH"
                                Command="{Binding RestartRosCommand}"
                                BackgroundColor="{StaticResource SurfaceElevated}" BorderColor="{StaticResource CardBorder}" BorderWidth="1"
                                TextColor="{StaticResource TextPrimary}" FontFamily="InterBold" FontSize="13" CornerRadius="12" HeightRequest="44" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Logs Card -->
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="SYSTEM JOURNAL CONSOLE" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="REFRESH" Command="{Binding LoadLogsCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource AccentCyan}"
                                    FontFamily="InterBold" FontSize="11" Padding="0" HeightRequest="32" />
                            </Grid>
                            <Label Text="{Binding LogsSummary}" FontSize="11" TextColor="{StaticResource TextDim}" FontFamily="InterRegular" />
                            <Border Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource CardInner}" Padding="10">
                                <CollectionView ItemsSource="{Binding Logs}" HeightRequest="180">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:LogEntry">
                                            <Label
                                                Text="{Binding Text}"
                                                FontSize="11"
                                                FontFamily="InterRegular"
                                                TextColor="{Binding IsError, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FB7185,#94A3B8'}"
                                                LineBreakMode="CharacterWrap"
                                                Padding="0,2" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- ═════════════════ SETTINGS TAB ═════════════════ -->
                <VerticalStackLayout x:Name="SettingsTab" Spacing="14" IsVisible="False">
                    <Border Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource CardBackground}" Padding="18">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="PAIRED ROBOT HARDWARE INFO" FontFamily="InterBold" FontSize="11" TextColor="{StaticResource TextMuted}" CharacterSpacing="1" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border
                                    Grid.Column="0"
                                    Stroke="{StaticResource Divider}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource CardInner}"
                                    WidthRequest="54"
                                    HeightRequest="54"
                                    VerticalOptions="Start">
                                    <Label Text="🤖" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding RobotName}" FontFamily="InterBold" FontSize="17" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="{Binding RobotModel}" FontSize="12" TextColor="{StaticResource TextMuted}" FontFamily="InterRegular" />
                                    <Label Text="{Binding RobotMdns}" FontSize="12" TextColor="{StaticResource AccentCyan}" FontFamily="InterSemiBold" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Divider}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="SERIAL" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                    <Label Text="{Binding RobotSerial}" FontSize="13" TextColor="{StaticResource TextPrimary}" FontFamily="InterBold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label Text="FIRMWARE" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                    <Label Text="{Binding RobotFirmware}" FontSize="13" TextColor="{StaticResource TextPrimary}" FontFamily="InterBold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                                    <Label Text="PAIRED AT" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                    <Label Text="{Binding PairedAt}" FontSize="13" TextColor="{StaticResource TextPrimary}" FontFamily="InterBold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                    <Label Text="APP BUILD" FontSize="10" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" CharacterSpacing="0.5" />
                                    <Label Text="{Binding AppVersion}" FontSize="13" TextColor="{StaticResource TextPrimary}" FontFamily="InterBold" />
                                </VerticalStackLayout>
                            </Grid>

                            <Button
                                Text="UNPAIR / FORGET ROBOT"
                                Command="{Binding ForgetRobotCommand}"
                                BackgroundColor="{StaticResource ErrorBackground}"
                                BorderColor="{StaticResource ErrorBorder}"
                                BorderWidth="1"
                                TextColor="{StaticResource ErrorText}"
                                FontFamily="InterBold"
                                FontSize="13"
                                CharacterSpacing="1"
                                CornerRadius="12"
                                HeightRequest="46"
                                Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Bottom Segmented Navigation Dock ───────────────────────────── -->
        <Border
            Grid.Row="2"
            StrokeThickness="0"
            BackgroundColor="{StaticResource SurfaceElevated}"
            Padding="12,10,12,24">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <!-- Telemetry Tab -->
                <Border Grid.Column="0" x:Name="TabTelemetry" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource CardInner}" Padding="0,8">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="📊" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Telemetry" FontSize="11" TextColor="{StaticResource AccentCyan}" FontFamily="InterBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Telemetry" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Camera Tab -->
                <Border Grid.Column="1" x:Name="TabCamera" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" Padding="0,8" Opacity="0.6">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="📷" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Camera" FontSize="11" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Camera" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Controls Tab -->
                <Border Grid.Column="2" x:Name="TabControls" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" Padding="0,8" Opacity="0.6">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="🎛" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Controls" FontSize="11" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Controls" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Settings Tab -->
                <Border Grid.Column="3" x:Name="TabSettings" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" Padding="0,8" Opacity="0.6">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="⚙" FontSize="18" HorizontalOptions="Center" />
                        <Label Text="Settings" FontSize="11" TextColor="{StaticResource TextMuted}" FontFamily="InterSemiBold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="Settings" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
