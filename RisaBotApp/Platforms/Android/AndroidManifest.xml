<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- The robot exposes plain HTTP only (ports 8000/8080/1984), so cleartext must be
	     permitted or every API call and the camera stream fail on Android 9+. -->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="RISA-Bot" android:usesCleartextTraffic="true"></application>
	<!-- Network access for robot API communication -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Camera required for ZXing QR code scanning on DiscoveryPage -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>