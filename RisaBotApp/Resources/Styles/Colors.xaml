<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Base Palette ────────────────────────────────────────────────── -->
    <Color x:Key="Primary">#00D4FF</Color>
    <Color x:Key="PrimaryDark">#0284C7</Color>
    <Color x:Key="PrimaryDarkText">#070B14</Color>
    <Color x:Key="Secondary">#1E2D48</Color>
    <Color x:Key="SecondaryDarkText">#94A3B8</Color>
    <Color x:Key="Tertiary">#E11D48</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#E11D48</Color>
    <Color x:Key="MidnightBlue">#070B14</Color>
    <Color x:Key="OffBlack">#0B111E</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#070B14</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ── Aerospace Cyber-Physical Control Palette ──────────────────────── -->
    <!-- Surfaces -->
    <Color x:Key="SplashBackground">#060911</Color>
    <Color x:Key="PageBackground">#080C16</Color>
    <Color x:Key="SurfaceElevated">#0E1626</Color>
    <Color x:Key="CardBackground">#111C30</Color>
    <Color x:Key="CardBackgroundHover">#16243D</Color>
    <Color x:Key="CardInner">#0B1322</Color>
    <Color x:Key="TabBarBackground">#080D18</Color>
    <Color x:Key="Divider">#1C2A44</Color>
    <Color x:Key="CardBorder">#1E2F4D</Color>
    <Color x:Key="BorderHighlight">#2D436B</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimary">#F8FAFC</Color>
    <Color x:Key="TextSecondary">#CBD5E1</Color>
    <Color x:Key="TextMuted">#72849E</Color>
    <Color x:Key="TextDim">#475569</Color>

    <!-- Functional Accents -->
    <Color x:Key="AccentBlue">#00D4FF</Color>
    <Color x:Key="AccentCyan">#00D4FF</Color>
    <Color x:Key="AccentTeal">#06B6D4</Color>
    <Color x:Key="AccentGreen">#10B981</Color>
    <Color x:Key="AccentEmerald">#10B981</Color>
    <Color x:Key="AccentOrange">#F59E0B</Color>
    <Color x:Key="AccentAmber">#F59E0B</Color>
    <Color x:Key="AccentRose">#F43F5E</Color>

    <!-- Status & Alerts -->
    <Color x:Key="ErrorBackground">#200B11</Color>
    <Color x:Key="ErrorBorder">#881337</Color>
    <Color x:Key="ErrorText">#FB7185</Color>
    <Color x:Key="SuccessBackground">#072017</Color>
    <Color x:Key="SuccessBorder">#065F46</Color>
    <Color x:Key="SuccessText">#34D399</Color>
    <Color x:Key="WarningBackground">#231705</Color>
    <Color x:Key="WarningBorder">#78350F</Color>
    <Color x:Key="WarningText">#FBBF24</Color>

    <!-- ── Official Brand Colors ────────────────────────────────────────── -->
    <Color x:Key="RisaCrimson">#E11D48</Color>
    <Color x:Key="RisaCrimsonDark">#9F1239</Color>
    <Color x:Key="RisaCrimsonLight">#FB7185</Color>
    <Color x:Key="RisaNavy">#0B1526</Color>
    <SolidColorBrush x:Key="RisaCrimsonBrush" Color="{StaticResource RisaCrimson}"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmerald}"/>

</ResourceDictionary>