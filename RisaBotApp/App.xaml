<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RisaBotApp"
             xmlns:conv="clr-namespace:RisaBotApp.Converters"
             x:Class="RisaBotApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global value converters — available on every page via {StaticResource ...} -->
            <conv:InvertBoolConverter        x:Key="InvertBoolConverter" />
            <conv:BoolToColorConverter       x:Key="BoolToColorConverter" />
            <conv:BoolToBadgeColorConverter  x:Key="BoolToBadgeColorConverter" />
            <conv:BoolToRosStatusConverter   x:Key="BoolToRosStatusConverter" />
            <conv:BoolToOnlineConverter      x:Key="BoolToOnlineConverter" />
            <conv:StringNotNullConverter     x:Key="StringNotNullConverter" />
            <conv:StringToColorConverter     x:Key="StringToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

