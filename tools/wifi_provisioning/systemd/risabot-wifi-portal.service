[Unit]
Description=RISA-Bot: WiFi Provisioning API (FastAPI, headless — RisaBotApp client)
After=risabot-ap-interface.service risabot-hostapd.service risabot-dnsmasq.service
Requires=risabot-ap-interface.service

[Service]
Type=simple
User=root
WorkingDirectory=/etc/risabot/portal/backend
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/local/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
