# Files that run on the robot (Linux) must keep LF endings regardless of the
# platform they were edited on. Without this, a checkout on Windows converts
# them to CRLF and bash fails on the robot with: $'\r': command not found
*.sh            text eol=lf
*.py            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.rules         text eol=lf
*.launch.py     text eol=lf
